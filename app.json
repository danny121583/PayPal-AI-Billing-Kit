{
  "expo": {
    "name": "PayPal AI Billing Kit",
    "slug": "paypal-ai-billing-kit",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paypalbillingkit",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paypalhackathon2026.billingkit"
    },
    "android": {
      "package": "com.paypalhackathon2026.billingkit"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
