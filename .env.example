# ----------------------------------------------------------------------------
# 2. Server-Only Edge Function Secrets (Synced via `node scripts/sync-local-env-secrets.mjs`)
#    NEVER expose these in client code or EXPO_PUBLIC_* variables!
#    Both PAYPAL_SANDBOX_* and PAYPAL_* naming conventions are supported.
# ----------------------------------------------------------------------------
# PAYPAL_ENV=sandbox
# PAYPAL_SANDBOX_CLIENT_ID=<your-paypal-developer-sandbox-client-id>
# PAYPAL_SANDBOX_CLIENT_SECRET=<your-paypal-developer-sandbox-client-secret>
# PAYPAL_SANDBOX_WEBHOOK_ID=<your-paypal-developer-sandbox-webhook-id>
# PAYPAL_CLIENT_ID=<alias-for-paypal-sandbox-client-id>
# PAYPAL_CLIENT_SECRET=<alias-for-paypal-sandbox-client-secret>
# PAYPAL_WEBHOOK_ID=<alias-for-paypal-sandbox-webhook-id>
# PAYPAL_SANDBOX_MERCHANT_ID=<your-sandbox-merchant-id>
# PAYPAL_SANDBOX_MERCHANT_EMAIL=sb-merchant@business.example.com
