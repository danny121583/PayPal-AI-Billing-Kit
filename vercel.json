{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "echo 'Using prebuilt dist'",
  "buildCommand": "echo 'Using prebuilt dist'",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/openapi.json",
      "destination": "https://paypal-ai-billing-mcp.apd1034.workers.dev/api/openapi.json"
    },
    {
      "source": "/api/mcp",
      "destination": "https://paypal-ai-billing-mcp.apd1034.workers.dev/mcp"
    },
    {
      "source": "/api/maas",
      "destination": "https://paypal-ai-billing-mcp.apd1034.workers.dev/mcp"
    },
    {
      "source": "/api/receipts/:path*",
      "destination": "https://paypal-ai-billing-mcp.apd1034.workers.dev/api/receipts/:path*"
    },
    {
      "source": "/docs/mcp",
      "destination": "https://paypal-ai-billing-mcp.apd1034.workers.dev/docs/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://paypal-ai-billing-mcp.apd1034.workers.dev/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://paypal-ai-billing-mcp.apd1034.workers.dev/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/jwks.json",
      "destination": "https://paypal-ai-billing-mcp.apd1034.workers.dev/.well-known/jwks.json"
    },
    {
      "source": "/((?!api/|docs/|_expo/|assets/|favicon\\.(?:ico|svg|png)|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Demo-Session-Id, mcp-session-id" }
      ]
    }
  ]
}
