{
  "name": "paypal-ai-billing-kit",
  "version": "1.6.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "verify:security": "node scripts/verify-security-and-rls.mjs",
    "verify:workflow": "node scripts/verify-e2e-billing-workflow.mjs",
    "verify:mcp": "node scripts/verify-maas-mcp.mjs",
    "verify:maas": "node scripts/verify-maas-mcp.mjs",
    "verify:ai-security": "node scripts/verify-security-and-ai.mjs",
    "verify:paypal-sandbox": "node scripts/verify-live-paypal-sandbox.mjs",
    "verify:e2e": "node scripts/verify-public-vercel-e2e.mjs",
    "sync:secrets": "node scripts/sync-local-env-secrets.mjs",
    "build:web": "EXPO_NO_TELEMETRY=1 npx expo export --platform web && node scripts/inject-web-favicon.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.95.3",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "playwright": "^1.50.0",
    "typescript": "~5.9.2"
  }
}
